+/// "Ask AI…" in a context menu: open the AI panel with the selection chip on and the input focused.
+pub fn ask_about_selection(app: &mut FilmcraftApp) {
+    app.ai.selection_off = false;
+    app.ai.focus_input = true;
+    app.ai.tab = Tab::Chat;
+    app.show_panel(crate::dock::PanelKind::AiChat);
+}
+
+pub fn show(app: &mut FilmcraftApp, ui: &mut egui::Ui, rect: Rect) {
+    let t = app.tokens;
+    let now = ui.input(|i| i.time);
+    let size = ui.style().text_styles.get(&egui::TextStyle::Body).map(|f| f.size).unwrap_or(13.0);
+    let mut elems: Vec<(String, egui::Response, String)> = Vec::new();
+    let st = &mut app.ai;
+    st.ensure_started(ui.ctx());
+    st.poll(now);
+    if st.busy.is_some() {
+        // the elapsed-time counter ticks while the AI works
+        ui.ctx().request_repaint_after(std::time::Duration::from_millis(500));
+    }
+
+    let mut child = ui.new_child(egui::UiBuilder::new().max_rect(rect.shrink2(vec2(8.0, 6.0))));
+    let ui = &mut child;
+
+    // ---- header ----
+    ui.label(RichText::new(tl!("Unofficial. Not made by the ArtCraft team.")).small().color(t.text_faint));
+    ui.horizontal(|ui| {
+        let folder = st.folder.clone().unwrap_or_else(|| tl!("no project folder").to_string());
+        let r = ui.label(RichText::new(format!("📁 {folder}")).color(t.text)).on_hover_text(tl!("The only folder the AI may read or write"));
+        elems.push(("ai.folder".into(), r, folder));
+        if !st.guard.is_empty() {
+            ui.label(RichText::new(tlf!("Guard {state}", state = st.guard.clone())).small().color(t.text_dim));
+        }
+    });
+    ui.horizontal(|ui| {
+        let models = if st.models.is_empty() { vec!["sonnet".to_string(), "opus".to_string(), "haiku".to_string()] } else { st.models.clone() };
+        let current = if st.model.is_empty() { models.first().cloned().unwrap_or_default() } else { st.model.clone() };
+        let mut picked = None;
+        let combo = craft_ui::ComboBox::from_id_salt("ai-model").selected_text(current.clone()).show_ui(ui, |ui| {
+            for m in &models {
+                if ui.selectable_label(*m == current, m.as_str()).clicked() {
+                    picked = Some(m.clone());
+                }
+            }
+        });
+        elems.push(("ai.model".into(), combo.response, current.clone()));
+        if let Some(m) = picked.filter(|m| *m != current) {
+            st.model = m.clone();
+            st.send(json!({"v": PROTOCOL, "type": "model", "model": m}));
+        }
+        let status = if st.no_token || !st.connected { tl!("Start craft-agent to chat").to_string() } else { tl!("Connected").to_string() };
+        let r = ui.label(RichText::new(status.clone()).small().color(t.text_dim));
+        elems.push(("ai.status".into(), r, status));
+    });
+    ui.horizontal(|ui| {
+        let chat = ui.selectable_label(st.tab == Tab::Chat, tl!("Chat"));
+        elems.push(("ai.tab.chat".into(), chat.clone(), "Chat".into()));
+        if chat.clicked() {
+            st.tab = Tab::Chat;
+        }
+        let act = ui.selectable_label(st.tab == Tab::Activity, tl!("Activity"));
+        elems.push(("ai.tab.activity".into(), act.clone(), "Activity".into()));
+        if act.clicked() {
+            st.tab = Tab::Activity;
+        }
+        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| match st.tab {
+            Tab::Chat => {
+                let rec = ui.add_enabled(st.connected, egui::Button::new(tl!("Recipes")).small().selected(st.recipes_open));
+                if rec.clicked() {
+                    st.recipes_open = !st.recipes_open;
+                }
+                elems.push(("ai.recipes".into(), rec, "Recipes".into()));
+                let save = ui
+                    .add_enabled(st.connected, egui::Button::new(tl!("Save chat")).small())
+                    .on_hover_text(tl!("Save the chat as Markdown in the project folder"));
+                elems.push(("ai.saveChat".into(), save.clone(), "Save chat".into()));
+                if save.clicked() {
+                    st.send(json!({"v": PROTOCOL, "type": "save_chat"}));
+                }
+                let copy = ui.add(egui::Button::new(tl!("Copy chat")).small());
+                elems.push(("ai.copyChat".into(), copy.clone(), "Copy chat".into()));
+                if copy.clicked() {
+                    ui.ctx().copy_text(transcript(&st.entries));
+                }
+            }
+            Tab::Activity => {
+                let copy = ui.add(egui::Button::new(tl!("Copy")).small());
+                elems.push(("ai.activity.copy".into(), copy.clone(), "Copy".into()));
+                if copy.clicked() {
+                    ui.ctx().copy_text(st.activity.join("\n"));
+                }
+            }
+        });
+    });
+
+    // ---- Guard banner (its own amber, on both tabs) ----
+    if let Some((text, preview)) = st.banner.clone() {
+        let mut dismiss = false;
+        let frame = egui::Frame::new().fill(BANNER_BG).corner_radius(4.0).inner_margin(8.0).show(ui, |ui| {
+            ui.set_width(ui.available_width());
+            ui.horizontal(|ui| {
+                ui.label(RichText::new(format!("⚠ {text}")).strong().color(BANNER_TEXT));
+                ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                    let r = ui.add(egui::Button::new(RichText::new("✕").color(BANNER_TEXT)).frame(false)).on_hover_text(tl!("Dismiss"));
+                    dismiss = r.clicked();
+                    elems.push(("ai.banner.dismiss".into(), r, "Dismiss".into()));
+                });
+            });
+            if !preview.is_empty() {
+                ui.add(
+                    egui::Label::new(
+                        RichText::new(tlf!(
+                            "It says: “{preview}”. The Guard marked it as untrusted; the AI is told not to follow it.",
+                            preview = preview.clone()
+                        ))
+                        .small()
+                        .color(BANNER_TEXT),
+                    )
+                    .selectable(true)
+                    .wrap(),
+                );
+            }
+        });
+        elems.push(("ai.banner".into(), frame.response, text));
+        if dismiss {
+            st.banner = None;
+        }
+    }
+    if let Some(err) = st.error.clone() {
+        let r = ui
+            .add(egui::Label::new(RichText::new(err.clone()).small().color(t.text_dim)).sense(egui::Sense::click()).wrap())
+            .on_hover_text(tl!("Click to dismiss"));
+        if r.clicked() {
+            st.error = None;
+        }
+    }
+
+    match st.tab {
+        Tab::Chat => chat_tab(st, ui, &t, size, now, &mut elems),
+        Tab::Activity => activity_tab(st, ui, &t, &mut elems),
+    }
+
+    for (id, r, label) in elems {
+        app.auto.add_response(&id, &r, &label);
+    }
+}
+
+fn chat_tab(st: &mut AiState, ui: &mut egui::Ui, t: &Tokens, size: f32, now: f64, elems: &mut Vec<(String, egui::Response, String)>) {
+    if st.recipes_open {
+        recipes_pane(st, ui, t, size, elems);
+    }
+    let working_h = if st.busy.is_some() { 26.0 } else { 0.0 };
+    let input_h = if st.selection.is_empty() { 64.0 } else { 90.0 };
+    let list_h = (ui.available_height() - input_h - working_h - 10.0).max(40.0);
+    let mut actions: Vec<Value> = Vec::new();
+    let mut copy: Option<String> = None;
+    egui::ScrollArea::vertical().id_salt("ai-chat-scroll").max_height(list_h).auto_shrink([false, false]).stick_to_bottom(true).show(ui, |ui| {
+        ui.set_width(ui.available_width());
+        ui.spacing_mut().item_spacing.y = 6.0;
+        if st.entries.is_empty() {
+            let hint = if st.connected { tl!("Ask for an edit, e.g. “add a 3 second black clip”.") } else { tl!("Start craft-agent to chat") };
+            ui.label(RichText::new(hint).color(t.text_faint));
+        }
+        for (i, e) in st.entries.iter().enumerate() {
+            match e {
+                Entry::User(text) => {
+                    let r = egui::Frame::new()
+                        .fill(t.field_bg)
+                        .stroke(Stroke::new(1.0, t.field_border))
+                        .corner_radius(4.0)
+                        .inner_margin(egui::Margin::symmetric(8, 6))
+                        .show(ui, |ui| {
+                            ui.set_width(ui.available_width());
+                            ui.horizontal_top(|ui| {
+                                ui.label(RichText::new("›").color(t.text_dim));
+                                ui.add(egui::Label::new(RichText::new(text).color(t.text)).selectable(true).wrap());
+                            });
+                        });
+                    elems.push((format!("ai.msg.{i}"), r.response, text.chars().take(120).collect()));
+                    copy_button(ui, t, i, text, &mut copy, elems);
+                }
+                Entry::Turn { id, tools, text, done } => {
+                    if !tools.is_empty() {
+                        let head = if *done { tlf!("Worked · {n} steps", n = tools.len()) } else { tlf!("Working · {n} steps", n = tools.len()) };
+                        let c = egui::CollapsingHeader::new(RichText::new(head.clone()).small().color(t.text_dim))
+                            .id_salt(("ai-turn", *id))
+                            .default_open(false)
+                            .show(ui, |ui| {
+                                for s in tools {
+                                    ui.add(egui::Label::new(RichText::new(format!("· {s}")).small().monospace().color(t.text_faint)).selectable(true).wrap());
+                                }
+                            });
+                        elems.push((format!("ai.turn.{id}.steps"), c.header_response, head));
+                    }
+                    if !text.is_empty() {
+                        let shown = if *done { text.clone() } else { format!("{text}▍") };
+                        let r = ui.add(egui::Label::new(markdown_job(&shown, t.text, size)).selectable(true).wrap());
+                        elems.push((format!("ai.msg.{i}"), r, text.chars().take(120).collect()));
+                        if *done {
+                            copy_button(ui, t, i, text, &mut copy, elems);
+                        }
+                    }
+                }
+                Entry::Card { n, title, steps, undo_count, state } => {
+                    let r = egui::Frame::new().fill(t.panel_bg).stroke(Stroke::new(1.0, t.field_border)).corner_radius(4.0).inner_margin(8.0).show(ui, |ui| {
+                        ui.set_width(ui.available_width());
+                        let mark = if *state == CardState::Applied { "✓" } else { "↶" };
+                        ui.add(egui::Label::new(RichText::new(format!("{mark} {title}")).font(Tokens::semibold(size)).color(t.text)).selectable(true).wrap());
+                        let steps_label = if steps.len() == 1 { tl!("1 step").to_string() } else { tlf!("{n} steps", n = steps.len()) };
+                        egui::CollapsingHeader::new(RichText::new(steps_label).small().color(t.text_dim))
+                            .id_salt(("ai-card-steps", *n))
+                            .default_open(false)
+                            .show(ui, |ui| {
+                                for s in steps {
+                                    ui.add(egui::Label::new(RichText::new(s).small().monospace().color(t.text_dim)).selectable(true).wrap());
+                                }
+                            });
+                        ui.horizontal(|ui| {
+                            let apply = ui.add_enabled(*state == CardState::Undone, egui::Button::new(tl!("Apply")));
+                            if apply.clicked() {
+                                actions.push(json!({"v": PROTOCOL, "type": "card_apply", "n": n}));
+                            }
+                            elems.push((format!("ai.card.{n}.apply"), apply, "Apply".into()));
+                            let undo = ui.add_enabled(*state == CardState::Applied && *undo_count > 0, egui::Button::new(tl!("Undo")));
+                            if undo.clicked() {
+                                actions.push(json!({"v": PROTOCOL, "type": "card_undo", "n": n}));
+                            }
+                            elems.push((format!("ai.card.{n}.undo"), undo, "Undo".into()));
+                            let undo_label = if *undo_count == 1 { tl!("1 undo step").to_string() } else { tlf!("{count} undo steps", count = undo_count) };
+                            ui.label(RichText::new(undo_label).small().color(t.text_faint));
+                            let save = ui
+                                .add(egui::Button::new(RichText::new(tl!("Save as recipe")).small()).frame(false))
+                                .on_hover_text(tl!("Save this request as a recipe in the project folder"));
+                            if save.clicked() {
+                                actions.push(json!({"v": PROTOCOL, "type": "save_recipe", "n": n}));
+                            }
+                            elems.push((format!("ai.card.{n}.saveRecipe"), save, "Save as recipe".into()));
+                        });
+                    });
+                    elems.push((format!("ai.card.{n}"), r.response, title.clone()));
+                }
+                Entry::Held { code, summary, reason, state, chat_allowable } => {
+                    let r = egui::Frame::new().fill(t.panel_bg).stroke(Stroke::new(1.5, t.accent)).corner_radius(4.0).inner_margin(8.0).show(ui, |ui| {
+                        ui.set_width(ui.available_width());
+                        ui.label(RichText::new(tl!("The AI wants to:")).small().color(t.text_dim));
+                        ui.add(egui::Label::new(RichText::new(summary).color(t.text)).selectable(true).wrap());
+                        if !reason.is_empty() {
+                            ui.add(egui::Label::new(RichText::new(reason).small().color(t.text_faint)).wrap());
+                        }
+                        match state {
+                            HeldState::Pending => {
+                                ui.horizontal_wrapped(|ui| {
+                                    let once = ui.button(tl!("Allow once"));
+                                    if once.clicked() {
+                                        actions.push(json!({"v": PROTOCOL, "type": "held_allow", "code": code, "scope": "once"}));
+                                    }
+                                    elems.push((format!("ai.held.{code}.allow"), once, "Allow once".into()));
+                                    if *chat_allowable {
+                                        let chat = ui
+                                            .button(tl!("Allow for this chat"))
+                                            .on_hover_text(tl!("Run this kind of action without asking until the chat ends"));
+                                        if chat.clicked() {
+                                            actions.push(json!({"v": PROTOCOL, "type": "held_allow", "code": code, "scope": "chat"}));
+                                        }
+                                        elems.push((format!("ai.held.{code}.allowChat"), chat, "Allow for this chat".into()));
+                                    }
+                                    let deny = ui.button(tl!("Deny"));
+                                    if deny.clicked() {
+                                        actions.push(json!({"v": PROTOCOL, "type": "held_deny", "code": code}));
+                                    }
+                                    elems.push((format!("ai.held.{code}.deny"), deny, "Deny".into()));
+                                });
+                            }
+                            HeldState::Allowed => {
+                                ui.label(RichText::new(tl!("Allowed once")).small().color(t.text_dim));
+                            }
+                            HeldState::AllowedChat => {
+                                ui.label(RichText::new(tl!("Allowed for this chat")).small().color(t.text_dim));
+                            }
+                            HeldState::Denied => {
+                                ui.label(RichText::new(tl!("Denied")).small().color(t.text_dim));
+                            }
+                        }
+                    });
+                    elems.push((format!("ai.held.{code}"), r.response, summary.clone()));
+                }
+                Entry::Note(text) => {
+                    ui.add(egui::Label::new(RichText::new(text).small().color(t.text_dim)).selectable(true).wrap());
+                }
+            }
+        }
+    });
+    if let Some(text) = copy {
+        ui.ctx().copy_text(text);
+    }
+    for a in actions {
+        st.send(a);
+    }
+
+    // ---- working indicator ----
+    if let Some(busy) = st.busy.clone() {
+        let secs = st.busy_since.map(|s| (now - s).max(0.0) as u64).unwrap_or(0);
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().size(12.0).color(t.text_dim));
+            let label = if busy.is_empty() { tlf!("Working… {secs}s", secs = secs) } else { format!("{busy} {secs}s") };
+            let r = ui.label(RichText::new(label.clone()).small().color(t.text_dim));
+            elems.push(("ai.working".into(), r, label));
+            let stop = ui.add(egui::Button::new(tl!("Stop")).small());
+            if stop.clicked() {
+                st.send(json!({"v": PROTOCOL, "type": "stop"}));
+            }
+            elems.push(("ai.stop".into(), stop, "Stop".into()));
+        });
+    }
+
+    // ---- selection chip: the request carries what is selected in the app ("fix THIS clip") ----
+    if st.connected && !st.selection.is_empty() {
+        let label = tlf!("Use selection: {what}", what = st.selection.clone());
+        let chip = ui
+            .add(egui::Button::new(RichText::new(label.clone()).small()).selected(!st.selection_off))
+            .on_hover_text(tl!("When on, the AI is told which clips are selected, where the playhead is and the In/Out range"));
+        if chip.clicked() {
+            st.selection_off = !st.selection_off;
+        }
+        elems.push(("ai.useSelection".into(), chip, label));
+    }
+
+    // ---- input: Enter sends, Shift+Enter is a new line, ↑ recalls the last prompt ----
+    let can_send = st.connected && st.busy.is_none();
+    let field = egui::Id::unique("ai-input-field");
+    if std::mem::take(&mut st.focus_input) {
+        ui.memory_mut(|m| m.request_focus(field));
+    }
+    let focused = ui.memory(|m| m.has_focus(field));
+    let mut send_now = false;
+    if focused {
+        let empty = st.input.is_empty();
+        let (enter, newline, up) = ui.input_mut(|i| {
+            // match Enter by hand: Shift (alone) = new line, no modifier = send; leave other chords alone
+            let (mut enter, mut newline) = (false, false);
+            i.events.retain(|e| match e {
+                egui::Event::Key { key: egui::Key::Enter, pressed, modifiers, .. } if !(modifiers.command || modifiers.ctrl || modifiers.alt) => {
+                    if *pressed {
+                        if modifiers.shift {
+                            newline = true;
+                        } else {
+                            enter = true;
+                        }
+                    }
+                    false
+                }
+                _ => true,
+            });
+            (enter, newline, empty && i.consume_key(egui::Modifiers::NONE, egui::Key::ArrowUp))
+        });
+        send_now = enter;
+        if newline {
+            insert_newline(ui.ctx(), field, &mut st.input);
+        }
+        if up && let Some(last) = st.prompts.last() {
+            st.input = last.clone();
+        }
+    }
+    ui.horizontal(|ui| {
+        let w = (ui.available_width() - 60.0).max(60.0);
+        let edit = ui.add(
+            egui::TextEdit::multiline(&mut st.input)
+                .id(field)
+                .desired_rows(2)
+                .desired_width(w)
+                .hint_text(tl!("Ask the AI to edit… (Enter sends, Shift+Enter new line)"))
+                .text_color(t.text),
+        );
+        elems.push(("ai.input".into(), edit.clone(), st.input.chars().take(200).collect()));
+        let send = ui.add_enabled(can_send, egui::Button::new(tl!("Send")));
+        if (send.clicked() || send_now) && can_send && !st.input.trim().is_empty() {
+            let text: String = st.input.trim().chars().take(MAX_TEXT).collect();
+            st.input.clear();
+            st.error = None;
+            if st.prompts.last() != Some(&text) {
+                st.prompts.push(text.clone());
+                let extra = st.prompts.len().saturating_sub(MAX_PROMPTS);
+                st.prompts.drain(..extra);
+            }
+            let use_selection = !st.selection_off && !st.selection.is_empty();
+            st.send(json!({"v": PROTOCOL, "type": "send", "text": text, "use_selection": use_selection}));
+            edit.request_focus();
+        }
+        elems.push(("ai.send".into(), send, "Send".into()));
+    });
+}
+
+/// Shift+Enter: a new line at the cursor (the field itself would treat Enter as Send).
+fn insert_newline(ctx: &egui::Context, id: egui::Id, text: &mut String) {
+    use egui::text::{CCursor, CCursorRange};
+    let mut state = egui::text_edit::TextEditState::load(ctx, id).unwrap_or_default();
+    let chars = text.chars().count();
+    let at = state.cursor.char_range().map(|r| r.primary.index.0).unwrap_or(chars).min(chars);
+    let byte = text.char_indices().nth(at).map(|(b, _)| b).unwrap_or(text.len());
+    text.insert(byte, '\n');
+    state.cursor.set_char_range(Some(CCursorRange::one(CCursor::new(at + 1))));
+    state.store(ctx, id);
+}
