+++ b/crates/ui-egui/src/panels/ai_chat.rs
@@ -0,0 +1,1456 @@
+//! AI panel: chat with an AI agent that edits the project through the official MCP server.
+//!
+//! The panel is UI only. It holds no API keys and makes no internet calls: it talks to a local
+//! agent process over `127.0.0.1` (port `CRAFT_AI_PORT`, default 7600), one JSON object per line,
+//! versioned `{"v":1,…}`, and proves itself with the token in `CRAFT_AI_TOKEN` (the agent starts
+//! FilmCraft with it). Without the agent the panel says how to start it and stays quiet.
+//! Every line from the socket is untrusted: sizes are capped and unknown messages are skipped.
+//! Colours, fonts and spacing come from the app theme; only the Guard banner has its own amber.
+//!
+//! Automation ids: `ai.tab.chat`, `ai.tab.activity`, `ai.status`, `ai.folder`, `ai.model`,
+//! `ai.copyChat`, `ai.saveChat`, `ai.banner`, `ai.banner.dismiss`, `ai.msg.<i>`, `ai.msg.<i>.copy`,
+//! `ai.turn.<id>.steps`, `ai.card.<n>`, `ai.card.<n>.apply`, `ai.card.<n>.undo`, `ai.held.<code>`,
+//! `ai.held.<code>.allow`, `ai.held.<code>.allowChat`, `ai.held.<code>.deny`, `ai.working`,
+//! `ai.stop`, `ai.input`, `ai.send`, `ai.activity.text`, `ai.activity.copy`.
+
+use egui::{Color32, Rect, RichText, Stroke, vec2};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+use crate::FilmcraftApp;
+use crate::theme::Tokens;
+
+/// Protocol version this panel speaks.
+pub const PROTOCOL: u64 = 1;
+/// Default agent port on 127.0.0.1.
+pub const DEFAULT_PORT: u16 = 7600;
+/// Longest accepted line from the agent (bytes); longer ones drop the connection.
+pub const MAX_LINE: usize = 1 << 20;
+/// Longest kept text field (characters).
+const MAX_TEXT: usize = 20_000;
+/// Most chat entries kept; older ones scroll away.
+const MAX_ENTRIES: usize = 400;
+/// Most steps shown on one change card or turn.
+const MAX_STEPS: usize = 64;
+/// Most activity lines kept.
+const MAX_ACTIVITY: usize = 2_000;
+/// Prompts kept for ↑ recall.
+const MAX_PROMPTS: usize = 50;
+/// The Guard banner's own colours: a fixed amber so the warning reads the same in every theme.
+const BANNER_BG: Color32 = Color32::from_rgb(0xF2, 0xC2, 0x3A);
+const BANNER_TEXT: Color32 = Color32::from_rgb(0x2A, 0x20, 0x00);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum CardState {
+    Applied,
+    Undone,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum HeldState {
+    Pending,
+    Allowed,
+    AllowedChat,
+    Denied,
+}
+
+/// A message from the agent.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum Incoming {
+    Hello {
+        #[serde(default)]
+        app: String,
+        #[serde(default)]
+        folder: Option<String>,
+        #[serde(default)]
+        guard: String,
+        #[serde(default)]
+        model: String,
+        #[serde(default)]
+        models: Vec<String>,
+    },
+    User {
+        id: u64,
+        text: String,
+    },
+    AiDelta {
+        id: u64,
+        text: String,
+    },
+    AiDone {
+        id: u64,
+        #[serde(default)]
+        text: String,
+    },
+    Tool {
+        id: u64,
+        #[serde(default)]
+        summary: String,
+    },
+    Card {
+        n: u64,
+        title: String,
+        #[serde(default)]
+        steps: Vec<String>,
+        undo_count: u32,
+        state: CardState,
+    },
+    Banner {
+        text: String,
+        #[serde(default)]
+        preview: String,
+    },
+    Held {
+        code: String,
+        summary: String,
+        #[serde(default)]
+        reason: String,
+        state: HeldState,
+        #[serde(default)]
+        chat_allowable: bool,
+    },
+    Status {
+        busy: bool,
+        #[serde(default)]
+        text: String,
+    },
+    Activity {
+        #[serde(default)]
+        reset: bool,
+        lines: Vec<String>,
+    },
+    Note {
+        text: String,
+    },
+    /// What is selected in the app right now (clips, playhead, In/Out), as a short label.
+    Selection {
+        #[serde(default)]
+        text: String,
+        #[serde(default)]
+        count: u32,
+    },
+    Recipes {
+        items: Vec<RecipeItem>,
+    },
+    RecipePreview {
+        id: String,
+        name: String,
+        #[serde(default)]
+        description: String,
+        request: String,
+        #[serde(default)]
+        will: Vec<String>,
+        #[serde(default)]
+        files: String,
+        #[serde(default)]
+        exports: String,
+        #[serde(default)]
+        warnings: Vec<RecipeWarning>,
+        #[serde(default)]
+        ignored: Vec<String>,
+        #[serde(default)]
+        flagged: bool,
+    },
+    Error {
+        text: String,
+    },
+}
+
+/// A recipe in the Recipes menu (built-in, or a file in the project's `.craft-ai/recipes`).
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+pub struct RecipeItem {
+    pub id: String,
+    pub name: String,
+    #[serde(default)]
+    pub description: String,
+    #[serde(default)]
+    pub params: std::collections::BTreeMap<String, Value>,
+    #[serde(default)]
+    pub builtin: bool,
+    #[serde(default)]
+    pub support: String,
+}
+
+/// Text in a recipe that the Guard flagged as talking to an AI.
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+pub struct RecipeWarning {
+    pub field: String,
+    pub text: String,
+}
+
+/// Recipe ids go into automation ids and back to the agent: `builtin:` / `file:` + a slug.
+fn recipe_id_ok(id: &str) -> bool {
+    !id.is_empty() && id.len() <= 80 && id.chars().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-' || c == ':')
+}
+
+fn param_value(v: &Value) -> String {
+    match v {
+        Value::String(s) => s.chars().take(200).collect(),
+        Value::Number(n) => n.to_string(),
+        _ => String::new(),
+    }
+}
+
+fn clip(s: &mut String) {
+    if s.chars().count() > MAX_TEXT {
+        *s = s.chars().take(MAX_TEXT).collect::<String>() + "…";
+    }
+}
+
+/// Parse and sanitise one line from the agent. Never panics; every field is size-capped.
+pub fn parse_line(line: &str) -> Result<Incoming, String> {
+    if line.len() > MAX_LINE {
+        return Err("line too long".into());
+    }
+    let v: Value = serde_json::from_str(line.trim()).map_err(|e| format!("not JSON: {e}"))?;
+    match v.get("v").and_then(Value::as_u64) {
+        Some(PROTOCOL) => {}
+        Some(other) => return Err(format!("protocol v{other}, this panel speaks v{PROTOCOL}")),
+        None => return Err("missing protocol version".into()),
+    }
+    let mut m: Incoming = serde_json::from_value(v).map_err(|e| format!("unknown message: {e}"))?;
+    match &mut m {
+        Incoming::Hello { app, folder, guard, model, models } => {
+            clip(app);
+            clip(guard);
+            clip(model);
+            if let Some(f) = folder {
+                clip(f);
+            }
+            models.truncate(16);
+            models.iter_mut().for_each(clip);
+        }
+        Incoming::User { text, .. } | Incoming::AiDelta { text, .. } | Incoming::AiDone { text, .. } | Incoming::Error { text } | Incoming::Note { text } => {
+            clip(text)
+        }
+        Incoming::Tool { summary, .. } => clip(summary),
+        Incoming::Card { title, steps, .. } => {
+            clip(title);
+            steps.truncate(MAX_STEPS);
+            steps.iter_mut().for_each(clip);
+        }
+        Incoming::Banner { text, preview } => {
+            clip(text);
+            clip(preview);
+        }
+        Incoming::Held { code, summary, reason, .. } => {
+            // codes go into automation ids and back to the agent: hex only
+            if code.is_empty() || code.len() > 16 || !code.chars().all(|c| c.is_ascii_hexdigit()) {
+                return Err("bad held-call code".into());
+            }
+            clip(summary);
+            clip(reason);
+        }
+        Incoming::Status { text, .. } => clip(text),
+        Incoming::Selection { text, .. } => {
+            if text.chars().count() > 200 {
+                *text = text.chars().take(200).collect::<String>() + "…";
+            }
+        }
+        Incoming::Recipes { items } => {
+            items.retain(|r| recipe_id_ok(&r.id));
+            items.truncate(100);
+            for r in items.iter_mut() {
+                clip(&mut r.name);
+                clip(&mut r.description);
+                clip(&mut r.support);
+                while r.params.len() > 16 {
+                    r.params.pop_last();
+                }
+            }
+        }
+        Incoming::RecipePreview { id, name, description, request, will, files, exports, warnings, ignored, .. } => {
+            if !recipe_id_ok(id) {
+                return Err("bad recipe id".into());
+            }
+            for s in [name, description, request, files, exports] {
+                clip(s);
+            }
+            will.truncate(16);
+            will.iter_mut().for_each(clip);
+            warnings.truncate(16);
+            for w in warnings.iter_mut() {
+                clip(&mut w.field);
+                clip(&mut w.text);
+            }
+            ignored.truncate(16);
+            ignored.iter_mut().for_each(clip);
+        }
+        Incoming::Activity { lines, .. } => {
+            let extra = lines.len().saturating_sub(MAX_ACTIVITY);
+            lines.drain(..extra);
+            for l in lines.iter_mut() {
+                if l.chars().count() > 2_000 {
+                    *l = l.chars().take(2_000).collect::<String>() + "…";
+                }
+            }
+        }
+    }
+    Ok(m)
+}
+
+/// Split complete lines off the front of `buf` (bytes after the last newline stay for later).
+pub fn take_lines(buf: &mut Vec<u8>) -> Vec<String> {
+    let mut out = Vec::new();
+    while let Some(i) = buf.iter().position(|b| *b == b'\n') {
+        let line: Vec<u8> = buf.drain(..=i).collect();
+        out.push(String::from_utf8_lossy(&line).trim_end().to_string());
+    }
+    out
+}
+
+#[derive(Clone, Debug)]
+enum Entry {
+    User(String),
+    /// One AI turn: the tools it used (collapsed) and its reply.
+    Turn {
+        id: u64,
+        tools: Vec<String>,
+        text: String,
+        done: bool,
+    },
+    Card {
+        n: u64,
+        title: String,
+        steps: Vec<String>,
+        undo_count: u32,
+        state: CardState,
+    },
+    Held {
+        code: String,
+        summary: String,
+        reason: String,
+        state: HeldState,
+        chat_allowable: bool,
+    },
+    Note(String),
+}
+
+/// The conversation as Markdown, for "Copy chat".
+fn transcript(entries: &[Entry]) -> String {
+    let mut out = String::new();
+    for e in entries {
+        match e {
+            Entry::User(t) => out.push_str(&format!("**You:** {t}\n\n")),
+            Entry::Turn { text, tools, .. } => {
+                if !tools.is_empty() {
+                    let n = if tools.len() == 1 { "1 step".to_string() } else { format!("{} steps", tools.len()) };
+                    out.push_str(&format!("_Worked · {n}: {}_\n\n", tools.join(", ")));
+                }
+                if !text.is_empty() {
+                    out.push_str(&format!("**AI:** {text}\n\n"));
+                }
+            }
+            Entry::Card { n, title, undo_count, state, .. } => {
+                let steps = if *undo_count == 1 { "1 undo step".to_string() } else { format!("{undo_count} undo steps") };
+                out.push_str(&format!("> Change {n}: {title} ({steps}, {state:?})\n\n"));
+            }
+            Entry::Held { summary, state, .. } => out.push_str(&format!("> Held: {summary} ({state:?})\n\n")),
+            Entry::Note(t) => out.push_str(&format!("> {t}\n\n")),
+        }
+    }
+    out
+}
+
+enum LinkEvent {
+    Connected,
+    Message(Incoming),
+    Skipped(String),
+    Disconnected(String),
+}
+
+struct Link {
+    out: std::sync::mpsc::Sender<String>,
+    events: std::sync::mpsc::Receiver<LinkEvent>,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+enum Tab {
+    #[default]
+    Chat,
+    Activity,
+}
+
+/// The panel's state (not saved: the conversation lives in the agent).
+#[derive(Default)]
+pub struct AiState {
+    link: Option<Link>,
+    started: bool,
+    no_token: bool,
+    connected: bool,
+    last_problem: Option<String>,
+    entries: Vec<Entry>,
+    input: String,
+    prompts: Vec<String>,
+    folder: Option<String>,
+    guard: String,
+    model: String,
+    models: Vec<String>,
+    busy: Option<String>,
+    busy_since: Option<f64>,
+    banner: Option<(String, String)>,
+    error: Option<String>,
+    tab: Tab,
+    activity: Vec<String>,
+    recipes: Vec<RecipeItem>,
+    recipes_open: bool,
+    recipe_sel: Option<String>,
+    recipe_vals: Vec<(String, String)>,
+    preview: Option<Incoming>,
+    /// The app selection as the agent last reported it, and whether requests should NOT carry it.
+    selection: String,
+    selection_off: bool,
+    /// Set by "Ask AI…" in a context menu: focus the input on the next frame.
+    focus_input: bool,
+}
+
+impl AiState {
+    fn send(&mut self, msg: Value) {
+        let Some(link) = &self.link else { return };
+        if let Ok(line) = serde_json::to_string(&msg) {
+            let _ = link.out.send(line);
+        }
+    }
+
+    fn push(&mut self, e: Entry) {
+        self.entries.push(e);
+        if self.entries.len() > MAX_ENTRIES {
+            let extra = self.entries.len() - MAX_ENTRIES;
+            self.entries.drain(..extra);
+        }
+    }
+
+    /// The turn with this id (created at the end if it isn't there yet).
+    fn turn(&mut self, id: u64) -> Option<&mut Entry> {
+        if !self.entries.iter().any(|e| matches!(e, Entry::Turn { id: i, .. } if *i == id)) {
+            self.push(Entry::Turn { id, tools: Vec::new(), text: String::new(), done: false });
+        }
+        self.entries.iter_mut().rev().find(|e| matches!(e, Entry::Turn { id: i, .. } if *i == id))
+    }
+
+    fn apply(&mut self, m: Incoming, now: f64) {
+        match m {
+            Incoming::Hello { folder, guard, model, models, .. } => {
+                self.folder = folder;
+                self.guard = guard;
+                self.model = model;
+                self.models = models;
+            }
+            Incoming::User { text, .. } => self.push(Entry::User(text)),
+            Incoming::AiDelta { id, text } => {
+                if let Some(Entry::Turn { text: t, .. }) = self.turn(id) {
+                    t.push_str(&text);
+                    clip(t);
+                }
+            }
+            Incoming::AiDone { id, text } => {
+                if let Some(Entry::Turn { text: t, done, .. }) = self.turn(id) {
+                    if !text.is_empty() {
+                        *t = text;
+                    }
+                    *done = true;
+                }
+            }
+            Incoming::Tool { id, summary } => {
+                if let Some(Entry::Turn { tools, .. }) = self.turn(id)
+                    && tools.len() < MAX_STEPS
+                {
+                    tools.push(summary);
+                }
+            }
+            Incoming::Card { n, title, steps, undo_count, state } => {
+                let card = Entry::Card { n, title, steps, undo_count, state };
+                match self.entries.iter_mut().find(|e| matches!(e, Entry::Card { n: k, .. } if *k == n)) {
+                    Some(slot) => *slot = card,
+                    None => self.push(card),
+                }
+            }
+            Incoming::Banner { text, preview } => self.banner = Some((text, preview)),
+            Incoming::Held { code, summary, reason, state, chat_allowable } => {
+                let held = Entry::Held { code: code.clone(), summary, reason, state, chat_allowable };
+                match self.entries.iter_mut().find(|e| matches!(e, Entry::Held { code: c, .. } if *c == code)) {
+                    Some(slot) => *slot = held,
+                    None => self.push(held),
+                }
+            }
+            Incoming::Status { busy, text } => {
+                if busy && self.busy.is_none() {
+                    self.busy_since = Some(now);
+                }
+                if !busy {
+                    self.busy_since = None;
+                    // a turn that ended without a final message is done anyway
+                    for e in self.entries.iter_mut() {
+                        if let Entry::Turn { done, .. } = e {
+                            *done = true;
+                        }
+                    }
+                }
+                self.busy = busy.then_some(text);
+            }
+            Incoming::Activity { reset, lines } => {
+                if reset {
+                    self.activity.clear();
+                }
+                self.activity.extend(lines);
+                let extra = self.activity.len().saturating_sub(MAX_ACTIVITY);
+                self.activity.drain(..extra);
+            }
+            Incoming::Note { text } => self.push(Entry::Note(text)),
+            Incoming::Selection { text, .. } => self.selection = text,
+            Incoming::Recipes { items } => self.recipes = items,
+            p @ Incoming::RecipePreview { .. } => self.preview = Some(p),
+            Incoming::Error { text } => self.error = Some(text),
+        }
+    }
+
+    /// Start the background connection once (desktop only).
+    fn ensure_started(&mut self, ctx: &egui::Context) {
+        if self.started {
+            return;
+        }
+        self.started = true;
+        let token = std::env::var("CRAFT_AI_TOKEN").unwrap_or_default();
+        if token.trim().is_empty() {
+            self.no_token = true;
+            return;
+        }
+        let port = std::env::var("CRAFT_AI_PORT").ok().and_then(|p| p.trim().parse::<u16>().ok()).unwrap_or(DEFAULT_PORT);
+        self.link = spawn_link(ctx.clone(), token, port);
+    }
+
+    fn poll(&mut self, now: f64) {
+        let mut events = Vec::new();
+        if let Some(link) = &self.link {
+            while let Ok(e) = link.events.try_recv() {
+                events.push(e);
+                if events.len() > 2000 {
+                    break; // the rest next frame
+                }
+            }
+        }
+        for e in events {
+            match e {
+                LinkEvent::Connected => {
+                    self.connected = true;
+                    self.last_problem = None;
+                }
+                LinkEvent::Message(m) => self.apply(m, now),
+                LinkEvent::Skipped(why) => log::warn!("AI panel: skipped a message from the agent: {why}"),
+                LinkEvent::Disconnected(why) => {
+                    self.connected = false;
+                    self.busy = None;
+                    self.busy_since = None;
+                    self.last_problem = Some(why);
+                }
+            }
+        }
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn spawn_link(ctx: egui::Context, token: String, port: u16) -> Option<Link> {
+    use std::io::{ErrorKind, Read, Write};
+    use std::net::{SocketAddr, TcpStream};
+    use std::sync::mpsc::{TryRecvError, channel};
+    use std::time::Duration;
+
+    let (out_tx, out_rx) = channel::<String>();
+    let (ev_tx, ev_rx) = channel::<LinkEvent>();
+    let addr = SocketAddr::from(([127, 0, 0, 1], port));
+    let spawned = std::thread::Builder::new().name("ai-panel-link".into()).spawn(move || {
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            'reconnect: loop {
+                let mut s = match TcpStream::connect_timeout(&addr, Duration::from_secs(1)) {
+                    Ok(s) => s,
+                    Err(e) => {
+                        if ev_tx.send(LinkEvent::Disconnected(e.to_string())).is_err() {
+                            return;
+                        }
+                        ctx.request_repaint();
+                        std::thread::sleep(Duration::from_secs(2));
+                        // drop what was typed while offline: the agent never saw it
+                        while out_rx.try_recv().is_ok() {}
+                        continue;
+                    }
+                };
+                let hello = json!({"v": PROTOCOL, "type": "hello", "token": token, "client": "filmcraft-ai-panel"}).to_string() + "\n";
+                if s.set_read_timeout(Some(Duration::from_millis(50))).is_err() || s.write_all(hello.as_bytes()).is_err() {
+                    std::thread::sleep(Duration::from_secs(2));
+                    continue;
+                }
+                if ev_tx.send(LinkEvent::Connected).is_err() {
+                    return;
+                }
+                ctx.request_repaint();
+                let mut buf: Vec<u8> = Vec::new();
+                let mut chunk = [0u8; 16 * 1024];
+                loop {
+                    match out_rx.try_recv() {
+                        Ok(line) => {
+                            if s.write_all(line.as_bytes()).and_then(|_| s.write_all(b"\n")).is_err() {
+                                let _ = ev_tx.send(LinkEvent::Disconnected("write failed".into()));
+                                continue 'reconnect;
+                            }
+                            continue;
+                        }
+                        Err(TryRecvError::Disconnected) => return, // the panel is gone
+                        Err(TryRecvError::Empty) => {}
+                    }
+                    match s.read(&mut chunk) {
+                        Ok(0) => {
+                            let _ = ev_tx.send(LinkEvent::Disconnected("the agent closed the connection".into()));
+                            ctx.request_repaint();
+                            std::thread::sleep(Duration::from_secs(1));
+                            continue 'reconnect;
+                        }
+                        Ok(n) => {
+                            buf.extend_from_slice(chunk.get(..n).unwrap_or(&[]));
+                            if buf.len() > MAX_LINE && !buf.contains(&b'\n') {
+                                let _ = ev_tx.send(LinkEvent::Disconnected("a message from the agent was too long".into()));
+                                continue 'reconnect;
+                            }
+                            let mut any = false;
+                            for line in take_lines(&mut buf) {
+                                if line.is_empty() {
+                                    continue;
+                                }
+                                let ev = match parse_line(&line) {
+                                    Ok(m) => LinkEvent::Message(m),
+                                    Err(e) => LinkEvent::Skipped(e),
+                                };
+                                if ev_tx.send(ev).is_err() {
+                                    return;
+                                }
+                                any = true;
+                            }
+                            if any {
+                                ctx.request_repaint();
+                            }
+                        }
+                        Err(e) if matches!(e.kind(), ErrorKind::WouldBlock | ErrorKind::TimedOut | ErrorKind::Interrupted) => {}
+                        Err(e) => {
+                            let _ = ev_tx.send(LinkEvent::Disconnected(e.to_string()));
+                            ctx.request_repaint();
+                            std::thread::sleep(Duration::from_secs(1));
+                            continue 'reconnect;
+                        }
+                    }
+                }
+            }
+        }));
+        if result.is_err() {
+            log::error!("AI panel connection thread stopped after a panic");
+        }
+    });
+    match spawned {
+        Ok(_) => Some(Link { out: out_tx, events: ev_rx }),
+        Err(e) => {
+            log::error!("AI panel: could not start its connection thread: {e}");
+            None
+        }
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+fn spawn_link(_ctx: egui::Context, _token: String, _port: u16) -> Option<Link> {
+    None
+}
