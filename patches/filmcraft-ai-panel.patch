+/// Inline style of a Markdown span.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MdStyle {
+    Plain,
+    Bold,
+    Code,
+}
+
+/// One line of basic Markdown: a list marker (`•` or `3.`), its nesting, heading or not, styled spans.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct MdLine {
+    pub marker: Option<String>,
+    pub indent: usize,
+    pub heading: bool,
+    pub spans: Vec<(String, MdStyle)>,
+}
+
+/// Parse the small Markdown subset the AI uses. Never panics; unclosed `**` or `` ` `` stay literal
+/// (a reply that is still streaming shows them until the closing marker arrives).
+pub fn markdown_lines(text: &str) -> Vec<MdLine> {
+    text.lines()
+        .map(|raw| {
+            let trimmed = raw.trim_start();
+            let indent = raw.len().saturating_sub(trimmed.len()).min(8) / 2;
+            let bullet = trimmed.strip_prefix("- ").or_else(|| trimmed.strip_prefix("* ")).or_else(|| trimmed.strip_prefix("• "));
+            let heading = trimmed.strip_prefix("### ").or_else(|| trimmed.strip_prefix("## ")).or_else(|| trimmed.strip_prefix("# "));
+            let (marker, is_heading, body) = if let Some(rest) = bullet {
+                (Some("•".to_string()), false, rest)
+            } else if let Some((num, rest)) = ordered_item(trimmed) {
+                (Some(format!("{num}.")), false, rest)
+            } else if let Some(rest) = heading {
+                (None, true, rest)
+            } else {
+                (None, false, trimmed)
+            };
+            MdLine { marker, indent, heading: is_heading, spans: inline_spans(body) }
+        })
+        .collect()
+}
+
+fn ordered_item(s: &str) -> Option<(u32, &str)> {
+    let digits = s.bytes().take_while(u8::is_ascii_digit).count();
+    if digits == 0 || digits > 3 {
+        return None;
+    }
+    let num = s.get(..digits)?.parse().ok()?;
+    let rest = s.get(digits..)?;
+    let rest = rest.strip_prefix(". ").or_else(|| rest.strip_prefix(") "))?;
+    Some((num, rest))
+}
+
+fn inline_spans(s: &str) -> Vec<(String, MdStyle)> {
+    fn push(out: &mut Vec<(String, MdStyle)>, s: &str, style: MdStyle) {
+        if s.is_empty() {
+            return;
+        }
+        match out.last_mut() {
+            Some((last, st)) if *st == style => last.push_str(s),
+            _ => out.push((s.to_string(), style)),
+        }
+    }
+    let mut out = Vec::new();
+    let mut rest = s;
+    loop {
+        let next = match (rest.find("**"), rest.find('`')) {
+            (Some(b), Some(c)) if c < b => Some((c, "`", MdStyle::Code)),
+            (Some(b), _) => Some((b, "**", MdStyle::Bold)),
+            (None, Some(c)) => Some((c, "`", MdStyle::Code)),
+            (None, None) => None,
+        };
+        let Some((i, delim, style)) = next else {
+            push(&mut out, rest, MdStyle::Plain);
+            break;
+        };
+        let before = rest.get(..i).unwrap_or_default();
+        let after = rest.get(i + delim.len()..).unwrap_or_default();
+        match after.find(delim) {
+            Some(j) if j > 0 => {
+                push(&mut out, before, MdStyle::Plain);
+                push(&mut out, after.get(..j).unwrap_or_default(), style);
+                rest = after.get(j + delim.len()..).unwrap_or_default();
+            }
+            _ => {
+                // no closing marker: keep the marker as text and go on after it
+                push(&mut out, rest.get(..i + delim.len()).unwrap_or_default(), MdStyle::Plain);
+                rest = after;
+            }
+        }
+    }
+    out
+}
