+/// The clip menu's "Ask AI…" opens the AI panel (off by default) for the selected clip.
+#[test]
+fn ask_ai_from_the_clip_menu_opens_the_ai_panel() {
+    let mut d = Driver::new();
+    let c = d.v1(0);
+    d.exec("timeline.select", json!({"clips": [c.id.0]}));
+    d.ok("ui.click", json!({"id": format!("timeline.clip.{}", c.id.0), "button": "right"}));
+    d.frames(3);
+    d.click("timeline.clipMenu.ai.ask");
+    d.frames(3);
+    let tabs = d.ok("ui.elements", json!({"prefix": "panel.tab.AiChat"}));
+    assert_eq!(tabs.as_array().map(Vec::len), Some(1), "the AI panel opened");
+    assert_eq!(d.ok("ui.inspect", json!({}))["ui"]["focused"], json!("AiChat"));
+}
