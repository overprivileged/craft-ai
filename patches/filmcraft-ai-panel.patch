+fn recipes_pane(st: &mut AiState, ui: &mut egui::Ui, t: &Tokens, size: f32, elems: &mut Vec<(String, egui::Response, String)>) {
+    let mut send: Option<Value> = None;
+    let frame = egui::Frame::new().fill(t.panel_bg).stroke(Stroke::new(1.0, t.field_border)).corner_radius(4.0).inner_margin(8.0).show(ui, |ui| {
+        ui.set_width(ui.available_width());
+        egui::ScrollArea::vertical().id_salt("ai-recipes-scroll").max_height(ui.available_height() * 0.6).show(ui, |ui| {
+            if st.recipes.is_empty() {
+                ui.label(RichText::new(tl!("No recipes yet.")).small().color(t.text_faint));
+            }
+            for r in st.recipes.clone() {
+                let picked = st.recipe_sel.as_deref() == Some(r.id.as_str());
+                let row = ui.selectable_label(picked, RichText::new(&r.name).font(Tokens::semibold(size)).color(t.text));
+                if row.clicked() {
+                    st.recipe_sel = Some(r.id.clone());
+                    st.recipe_vals = r.params.iter().map(|(k, v)| (k.clone(), param_value(v))).collect();
+                    st.preview = None;
+                }
+                elems.push((format!("ai.recipe.{}", r.id.replace(':', ".")), row, r.name.clone()));
+                if !r.description.is_empty() {
+                    ui.add(egui::Label::new(RichText::new(&r.description).small().color(t.text_dim)).wrap());
+                }
+                if !r.support.is_empty() {
+                    ui.add(egui::Label::new(RichText::new(&r.support).small().color(t.text_faint)).wrap());
+                }
+                if picked {
+                    for (k, v) in st.recipe_vals.iter_mut() {
+                        ui.horizontal(|ui| {
+                            ui.label(RichText::new(k.as_str()).small().color(t.text_dim));
+                            let e = ui.add(egui::TextEdit::singleline(v).desired_width(ui.available_width()).text_color(t.text));
+                            elems.push((format!("ai.recipe.param.{k}"), e, v.clone()));
+                        });
+                    }
+                    let b = ui.button(tl!("Preview"));
+                    if b.clicked() {
+                        send = Some(json!({"v": PROTOCOL, "type": "recipe_preview", "id": r.id, "values": vals_json(&st.recipe_vals)}));
+                    }
+                    elems.push(("ai.recipe.preview".into(), b, "Preview".into()));
+                }
+                ui.add_space(4.0);
+            }
+        });
+        if let Some(Incoming::RecipePreview { id, name, will, files, exports, warnings, ignored, flagged, .. }) = st.preview.clone()
+            && st.recipe_sel.as_deref() == Some(id.as_str())
+        {
+            ui.separator();
+            let head = ui.label(RichText::new(tlf!("This recipe will: ({name})", name = name)).font(Tokens::semibold(size)).color(t.text));
+            elems.push(("ai.recipe.previewCard".into(), head, name.clone()));
+            for w in &will {
+                ui.add(egui::Label::new(RichText::new(format!("• {w}")).color(t.text)).selectable(true).wrap());
+            }
+            ui.add(egui::Label::new(RichText::new(tlf!("Touches files: {files}", files = files)).small().color(t.text_dim)).wrap());
+            ui.add(egui::Label::new(RichText::new(tlf!("Exports: {exports}", exports = exports)).small().color(t.text_dim)).wrap());
+            if !ignored.is_empty() {
+                let list = ignored.join(", ");
+                ui.add(
+                    egui::Label::new(
+                        RichText::new(tlf!("Ignored: {list} (recipes can't change the Guard, the fence or the allow rule)", list = list))
+                            .small()
+                            .color(t.text_dim),
+                    )
+                    .wrap(),
+                );
+            }
+            for w in &warnings {
+                ui.add(egui::Label::new(RichText::new(format!("⚠ {}: {}", w.field, w.text)).small().color(t.text)).selectable(true).wrap());
+            }
+            ui.horizontal(|ui| {
+                let label = if flagged { tl!("Run anyway") } else { tl!("Run") };
+                let run = ui.add_enabled(st.busy.is_none(), egui::Button::new(label));
+                if run.clicked() {
+                    send = Some(json!({"v": PROTOCOL, "type": "recipe_run", "id": id, "values": vals_json(&st.recipe_vals)}));
+                    st.preview = None;
+                    st.recipes_open = false;
+                }
+                elems.push(("ai.recipe.run".into(), run, label.to_string()));
+                let cancel = ui.button(tl!("Cancel"));
+                if cancel.clicked() {
+                    st.preview = None;
+                }
+                elems.push(("ai.recipe.cancel".into(), cancel, "Cancel".into()));
+            });
+        }
+    });
+    elems.push(("ai.recipes.pane".into(), frame.response, "Recipes".into()));
+    if let Some(m) = send {
+        st.send(m);
+    }
+}
