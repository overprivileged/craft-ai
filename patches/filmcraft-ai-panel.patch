+fn markdown_job(text: &str, color: Color32, size: f32) -> egui::text::LayoutJob {
+    use crate::theme::Tokens;
+    use egui::text::{LayoutJob, TextFormat};
+    let fmt = |font_id: egui::FontId| TextFormat { font_id, color, ..Default::default() };
+    let mut job = LayoutJob::default();
+    for (k, line) in markdown_lines(text).iter().enumerate() {
+        if k > 0 {
+            job.append("\n", 0.0, fmt(Tokens::ui(size)));
+        }
+        let mut lead = line.indent as f32 * 12.0;
+        if let Some(m) = &line.marker {
+            job.append(&format!("{m} "), lead, fmt(Tokens::ui(size)));
+            lead = 0.0;
+        }
+        for (s, style) in &line.spans {
+            let font = match style {
+                _ if line.heading => Tokens::semibold(size),
+                MdStyle::Bold => Tokens::semibold(size),
+                MdStyle::Code => Tokens::mono(size * 0.95),
+                MdStyle::Plain => Tokens::ui(size),
+            };
+            job.append(s, lead, fmt(font));
+            lead = 0.0;
+        }
+    }
+    job
+}
