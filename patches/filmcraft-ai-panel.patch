+/// The AI panel is off by default, opens from Window ▸ AI along the right edge of the workspace,
+/// and without a running agent says how to start one (no connection errors in the panel).
+#[test]
+fn ai_panel_is_off_by_default_opens_on_the_right_and_waits_for_the_agent() {
+    let mut d = Driver::demo();
+    assert!(!d.has("panel.tab.AiChat"), "the AI panel is not in the default workspace");
+    let window: Vec<String> = d
+        .ok("ui.menu.list", json!({}))
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|m| m["path"] == json!(["Window"]))
+        .filter_map(|m| m["label"].as_str().map(str::to_string))
+        .collect();
+    assert!(window.iter().any(|w| w == "AI"), "AI not in Window: {window:?}");
+    d.ok("ui.menu.invoke", json!({"id": "window.panel.AiChat"}));
+    d.frames(3);
+    assert!(d.has("panel.tab.AiChat"), "AI has no tab");
+    for id in ["ai.status", "ai.folder", "ai.model", "ai.input", "ai.send"] {
+        assert!(d.has(id), "no {id}");
+    }
+    if std::env::var("CRAFT_AI_TOKEN").map(|t| t.is_empty()).unwrap_or(true) {
+        assert_eq!(d.label("ai.status"), "Start craft-agent to chat");
+    }
+    let rects = d.rects("panel.");
+    let ai = rects.iter().find(|(id, _)| id == "panel.AiChat").map(|(_, r)| *r).expect("AI panel rect");
+    let right = rects.iter().filter(|(id, _)| id.strip_prefix("panel.").is_some_and(|k| !k.contains('.'))).map(|(_, r)| r.max.x).fold(0.0, f32::max);
+    assert!(ai.max.x >= right - 1.0, "AI panel is not at the right edge: {ai:?} vs {right}");
+    assert!(ai.width() > 150.0, "AI panel too narrow: {ai:?}");
+    // typing reaches the input box, also with the native window in the background (ui.focus {id})
+    d.ok("ui.focus", json!({"id": "ai.input"}));
+    d.frames(1);
+    d.ok("ui.type", json!({"text": "add a 3 second black clip"}));
+    d.frames(2);
+    assert_eq!(d.label("ai.input"), "add a 3 second black clip");
+    // Shift+Enter is a new line (Enter alone sends)
+    d.ok("ui.key", json!({"key": "Shift+Enter"}));
+    d.ok("ui.type", json!({"text": "then fade"}));
+    d.frames(2);
+    assert_eq!(d.label("ai.input"), "add a 3 second black clip\nthen fade");
+    for id in ["ai.copyChat", "ai.saveChat", "ai.tab.chat", "ai.tab.activity"] {
+        assert!(d.has(id), "no {id}");
+    }
+    d.click("ai.tab.activity");
+    d.frames(2);
+    assert!(d.has("ai.activity.text") && d.has("ai.activity.copy"), "Activity tab");
+    assert!(!d.has("ai.input"), "the Activity tab has no chat input");
+    d.click("ai.tab.chat");
+    d.frames(2);
+    assert!(d.has("ai.input"));
+}
